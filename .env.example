# ---- Telegram (required for alerts) ----------------------------------
# 1. Message @BotFather on Telegram, send /newbot, copy the token here.
TELEGRAM_BOT_TOKEN=

# 2. Send your new bot any message, then open
#    https://<your-app>.vercel.app/api/telegram?key=<CRON_SECRET>
#    and copy the id it reports. Several ids can be comma-separated.
TELEGRAM_CHAT_ID=

# ---- Scheduler -------------------------------------------------------
# Any random string. Protects the cron endpoint from strangers.
CRON_SECRET=

# Must match how often your scheduler actually calls /api/cron.
CRON_INTERVAL_MINUTES=5

# How long before a session opens you want the heads-up.
ALERT_LEAD_MINUTES=15

# ---- Optional: exact de-duplication ----------------------------------
# Only needed if your scheduler is unreliable and you start seeing repeats.
# Free tier at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
